# Fictional placeholders. Generate independent local secrets before running.
NODE_ENV=development
PORT=8085
BIND_HOST=127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=autopay
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_DATABASE=autopay_redm
SERVICE_TOKEN=replace-with-a-random-service-token
SERVICE_HMAC_SECRET=replace-with-an-independent-random-hmac-secret
ADMIN_JWT_SECRET=replace-with-an-independent-random-jwt-secret
MP_ACCESS_TOKEN=replace-with-your-sandbox-access-token
MP_WEBHOOK_SECRET=replace-with-your-provider-webhook-secret
MP_PAYER_EMAIL=player@example.com
MP_NOTIFICATION_URL=https://payments.example.com/v1/webhooks/pix
# Optional exact addresses. Signatures remain mandatory.
WEBHOOK_ALLOWED_IPS=
# Implement the documented receiver before enabling callbacks.
REDM_CALLBACK_URL=
REDM_CATALOG_CALLBACK_URL=
REDM_CALLBACK_TOKEN=replace-with-an-independent-random-callback-token
